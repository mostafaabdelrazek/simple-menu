APP_NAME=SimpleMenu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Bump this on each release to force re-caching of built assets (public/build)
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simplemenu
DB_USERNAME=dev_user
DB_PASSWORD=0000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# OTP delivery driver: log (dev) — see App\Services\Otp
OTP_DRIVER=log
OTP_TTL=10
OTP_DIGITS=6

# Billing. BILLING_DRIVER: "none" = no gateway (upgrades become trials,
# admin can grant plans by hand); "paymob" = live Paymob Checkout.
BILLING_DRIVER=none
BILLING_CURRENCY=EGP
BILLING_TRIAL_DAYS=14

# Paymob Accept (https://accept.paymob.com). Get these from the Paymob
# dashboard → Developers:
#   PAYMOB_API_KEY        → API Keys section
#   PAYMOB_INTEGRATION_ID → Payment Integrations (online card integration)
#   PAYMOB_IFRAME_ID      → Payment Integrations → Iframes
#   PAYMOB_HMAC_SECRET    → the HMAC secret field (also used in webhooks)
PAYMOB_BASE_URL=https://accept.paymob.com/api
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Public page cache (hot path for QR scans)
PUBLIC_CACHE_ENABLED=true
PUBLIC_CACHE_TTL=3600

VITE_APP_NAME="${APP_NAME}"